{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting": "Information",
        "System": "Warning",
        "Serilog.AspNetCore": "Warning"
      }
    },
    "Filter": [],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\DeployedApps\\logs\\ue-mes-api\\ue_mes_api.log",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "rollingInterval": "Day",
          "retainedFileCountLimit": 10,
          "buffered": false,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithExceptionDetails",
      "WithDefaultDestructurers",
      "WithProcessId",
      "WithThreadId",
      "WithMachineName",
      "WithEnvironmentUserName"
    ]
  },
  "Products": {
    "TempFolder": "%TEMP%",
    "BackendServiceUrl": "http://%GATEWAY%/backend"
  },
  "WorkElements": {
    "ImagesFolder": "C:\\DeployedApps\\ue-mes-images"
  },
  "AuthenticationSettings": {
    "JwtSecret": "",
    "JwtEmailEncryption": ""
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000",
  "ConnectionStrings": {
    "MesProductionEntities": "Server=localhost;Database=MesProduction;user id=MesAccount;password=MesAccount!;Trusted_Connection=False;TrustServerCertificate=Yes;"
  }
}
